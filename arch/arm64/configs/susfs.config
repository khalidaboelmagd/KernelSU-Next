#
# SUSFS v2.2.0 (NON-GKI) config fragment for OnePlus 7/7T Pro, OxygenOS 11.
#
# Merged on top of blu_spark_defconfig by scripts/kconfig/merge_config.sh in
# the "susfs" matrix variant. blu_spark_defconfig itself stays SUSFS-free so
# the fallback build remains byte-for-byte the known-good configuration.
#
# Only features whose kernel-side hooks are actually present in this tree are
# enabled. The set below matches what sidex15 ships on his sm8150 4.14 tree,
# which is the reference this port was taken from.
#
# Hook mode is NOT set here on purpose: KSU_KPROBES_HOOK auto-selects because
# CONFIG_KPROBES/KRETPROBES/HAVE_SYSCALL_TRACEPOINTS are all =y, which is the
# same mode the existing working build uses.
#
CONFIG_KSU=y
CONFIG_KSU_SUSFS=y
CONFIG_KSU_SUSFS_SUS_MOUNT=y
CONFIG_KSU_SUSFS_SUS_MAP=y
CONFIG_KSU_SUSFS_TRY_UMOUNT=y
CONFIG_KSU_SUSFS_SUS_MEMFD=y
CONFIG_KSU_SUSFS_ENABLE_LOG=y

#
# Deliberately left OFF. These have hooks in this tree and can be turned on
# one at a time once the first SUSFS build is confirmed to boot and grant root:
#
# CONFIG_KSU_SUSFS_SUS_KSTAT is not set
# CONFIG_KSU_SUSFS_SPOOF_UNAME is not set
# CONFIG_KSU_SUSFS_SPOOF_CMDLINE_OR_BOOTCONFIG is not set

#
# Deliberately left OFF - kernel-side hooks are NOT ported to this tree yet.
# Enabling either would build a kernel where the feature silently does nothing
# (SUS_PATH) or only partly works (OPEN_REDIRECT). The workflow asserts these
# stay unset; port the fs/namei.c + fs/readdir.c hooks before flipping them.
#
# CONFIG_KSU_SUSFS_SUS_PATH is not set
# CONFIG_KSU_SUSFS_OPEN_REDIRECT is not set
# CONFIG_KSU_SUSFS_HIDE_KSU_SUSFS_SYMBOLS is not set
